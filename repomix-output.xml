}

.live2d-settings-toggle span::before,
.live2d-settings-toggle span::after {
  content: "";
  position: absolute;
  left: 0;
}

.live2d-settings-toggle span::before {
  top: -8px;
}

.live2d-settings-toggle span::after {
  top: 8px;
}

.live2d-widget.live2d-settings-visible .live2d-settings-toggle,
.live2d-widget.live2d-settings-open .live2d-settings-toggle {
