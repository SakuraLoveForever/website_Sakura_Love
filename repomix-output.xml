  top: calc(var(--live2d-toggle-y, 45%) + 52px);
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  border: 1px solid var(--hairline);
  border-radius: 12px;
  background: rgba(250, 250, 252, 0.94);
  backdrop-filter: blur(var(--glass-blur-compact));
  -webkit-backdrop-filter: blur(var(--glass-blur-compact));
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.14);
  white-space: nowrap;
  color: var(--muted);
  font-size: 13px;
  transform: translateY(-50%);
}
.live2d-speed-panel[hidden] {
