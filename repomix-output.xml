}

.player-bar-play svg {
  width: 20px;
  height: 20px;
  fill: currentColor;
}

.player-bar-play .music-pause-icon,
.player-bar-play.is-playing .music-play-icon {
  display: none;
}

.player-bar-play.is-playing .music-pause-icon {
  display: block;
}

.player-bar-right {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1 1 auto;
  justify-content: flex-end;
  min-width: 0;
}

.music-library-progress {
  flex: 0 1 200px;
  min-width: 80px;
  height: 18px;
  appearance: none;
  -webkit-appearance: none;
  background: transparent;
  border: 0;
  padding: 0;
  accent-color: var(--primary);
  --library-seek: 0%;
