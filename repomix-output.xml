  color: var(--primary);
  background: rgba(41, 151, 255, 0.14);
}

/* ---- 双栏主体 ---- */
.music-library-body {
  display: flex;
  gap: 20px;
  align-items: stretch;
}

.music-library-left {
  width: 340px;
  flex: none;
  min-width: 0;
  min-height: 0;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: rgba(255,255,255,0.12) transparent;
  padding: 4px 4px 0 0;
  will-change: scroll-position;
  transform: translateZ(0);
  backface-visibility: hidden;
  -webkit-overflow-scrolling: touch;
  contain: layout style;
}

.music-library-left::-webkit-scrollbar {
  width: 5px;
}

.music-library-left::-webkit-scrollbar-thumb {
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.12);
}

.music-library-right {
  flex: 1;
  min-width: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.music-library-stage {
  position: relative;
  aspect-ratio: 1/1;
  width: 100%;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 14px;
  background: var(--canvas);
  isolation: isolate;
  box-shadow: 0 4px 40px rgba(0, 0, 0, 0.35);
}

.music-library-stage .bg-layer {
  background-color: transparent;
  background-size: contain;
}

/* ---- 底部播放栏 ---- */
.music-player-bar {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 12px 16px;
  border: 1px solid rgba(255, 255, 255, 0.1);
