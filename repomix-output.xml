.card {
  display: flex;
  flex-direction: column;
  min-height: 260px;
  padding: 24px;
  border: 1px solid var(--hairline);
  border-radius: var(--panel-radius);
  background: var(--canvas);
  color: var(--ink);
  position: relative;
  isolation: isolate;
  overflow: hidden;
  --mx: 50%;
  --my: 50%;
  transition: border-color 0.35s ease;
}

.card::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  opacity: 0;
  background: radial-gradient(
    circle 320px at var(--mx) var(--my),
    rgba(120, 120, 128, 0.08),
    transparent 55%
  );
  transition: opacity 0.38s ease;
  pointer-events: none;
  border-radius: inherit;
}

.card:hover::before {
  opacity: 1;
}

.card::after {
  content: "";
  position: absolute;
  inset: -1px;
  z-index: -2;
  opacity: 0;
  background: radial-gradient(
    circle 280px at var(--mx) var(--my),
    rgba(120, 120, 128, 0.13),
    transparent 55%
  );
  transition: opacity 0.38s ease;
  pointer-events: none;
  border-radius: inherit;
}

.card:hover::after {
  opacity: 1;
}

.card:hover {
  border-color: rgba(120, 120, 128, 0.22);
}

.card h3 {
  margin: 0 0 16px;
  font-size: 17px;
  font-weight: 600;
  line-height: 1.24;
}

.card p {
  margin: 0;
  color: var(--muted);
  font-size: 17px;
  line-height: 1.47;
}

.project-title-btn {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  min-width: 0;
  white-space: normal;
  color: var(--primary);
  font-weight: 600;
}

