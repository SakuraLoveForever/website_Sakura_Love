}

.live2d-widget {
  position: fixed;
  left: var(--live2d-x, 8px);
  top: var(--live2d-y, auto);
  right: auto;
  bottom: var(--live2d-bottom, 0);
  z-index: 9997;
  --live2d-base-w: min(280px, 48vw);
  --live2d-base-h: min(560px, 82vh);
  width: calc(var(--live2d-base-w) * var(--live2d-size, 1));
  height: calc(var(--live2d-base-h) * var(--live2d-size, 1));
  overflow: visible;
  pointer-events: auto;
  cursor: default;
  touch-action: none;
  user-select: none;
}

.live2d-widget.dragging {
  cursor: grabbing;
  transition: none;
}

.live2d-widget.live2d-loading {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: none;
}

.live2d-widget canvas {
  display: block;
  width: 100%;
  height: 100%;
}

.live2d-widget.live2d-hidden {
  display: none;
}

.live2d-settings-toggle {
  position: absolute;
  left: var(--live2d-toggle-x, calc(100% + 8px));
  top: var(--live2d-toggle-y, 45%);
  z-index: 2;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  min-width: 44px;
  height: 44px;
  padding: 0;
  border: 1px solid var(--hairline);
  border-radius: var(--pill);
  background: rgba(250, 250, 252, 0.92);
  color: var(--ink);
  cursor: pointer;
  opacity: 0;
  pointer-events: none;
  transform: translateY(-50%) scale(0.92);
  backdrop-filter: saturate(var(--glass-saturate-strong)) blur(var(--glass-blur-compact));
  -webkit-backdrop-filter: saturate(var(--glass-saturate-strong)) blur(var(--glass-blur-compact));
  transition: opacity 0.18s ease, transform 0.18s ease, background-color 0.18s ease;
}

.live2d-settings-toggle span,
.live2d-settings-toggle span::before,
.live2d-settings-toggle span::after {
  display: block;
  width: 4px;
  height: 4px;
  border-radius: 50%;
