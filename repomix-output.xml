/* ===== 音乐收藏 — 角色导航卡片 ===== */

.music-library-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  align-content: flex-start;
  padding-right: 4px;
}

/* ---- 角色卡片 ---- */
.music-role-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 10px;
  border: 2px solid transparent;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.04);
  cursor: pointer;
  transition: border-color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  position: relative;
}

.music-role-group:hover {
  border-color: rgba(255, 255, 255, 0.16);
  background: rgba(255, 255, 255, 0.07);
  transform: translateY(-2px);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
}

.music-role-group.is-active {
  border-color: var(--primary);
  background: linear-gradient(135deg, rgba(41, 151, 255, 0.12) 0%, rgba(130, 80, 255, 0.08) 100%);
  box-shadow: 0 0 24px rgba(41, 151, 255, 0.18), 0 8px 32px rgba(0, 0, 0, 0.3);
  transform: translateY(-3px);
}

.music-role-group.is-active::before {
  content: "";
  position: absolute;
  inset: -2px;
  border-radius: 16px;
  padding: 2px;
  background: linear-gradient(135deg, var(--primary), rgba(130, 80, 255, 0.6));
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}

/* -- 角色缩略图 -- */
.music-role-thumb-sm {
  display: block;
