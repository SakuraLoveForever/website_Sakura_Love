}

.music-library-progress::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 14px;
  height: 14px;
  margin-top: -5px;
  border: 2px solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
  background: var(--primary);
  cursor: pointer;
  box-shadow: 0 2px 6px rgba(0,0,0,0.3);
}

.music-library-progress::-webkit-slider-thumb:hover {
  transform: scaleY(1.25);
}

.music-library-progress::-moz-range-track {
  height: 4px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.1);
}

.music-library-progress::-moz-range-progress {
  height: 4px;
  border-radius: 999px;
  background: var(--primary);
}

.music-library-progress::-moz-range-thumb {
  width: 14px;
  height: 14px;
  border: 2px solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
  background: var(--primary);
  cursor: pointer;
  box-shadow: 0 2px 6px rgba(0,0,0,0.3);
}

.music-library-vol {
  flex-shrink: 0;
  width: 80px;
  height: 18px;
  appearance: none;
  -webkit-appearance: none;
  background: transparent;
  border: 0;
  padding: 0;
  accent-color: var(--primary);
  --library-vol: 70%;
  cursor: pointer;
}

.music-library-vol::-webkit-slider-runnable-track {
  height: 4px;
  border-radius: 999px;
  background: linear-gradient(to right, var(--primary) 0%, var(--primary) var(--library-vol), rgba(255, 255, 255, 0.1) var(--library-vol), rgba(255, 255, 255, 0.1) 100%);
}

.music-library-vol::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 14px;
  height: 14px;
  margin-top: -5px;
  border: 2px solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
  background: var(--primary);
  cursor: pointer;
  box-shadow: 0 2px 6px rgba(0,0,0,0.3);
}

.music-library-vol::-moz-range-track {
  height: 4px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.1);
}

.music-library-vol::-moz-range-progress {
  height: 4px;
  border-radius: 999px;
  background: var(--primary);
}

.music-library-vol::-moz-range-thumb {
  width: 14px;
  height: 14px;
  border: 2px solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
  background: var(--primary);
  cursor: pointer;
  box-shadow: 0 2px 6px rgba(0,0,0,0.3);
}

/* -- 移除旧按钮矩阵 -- */
.music-library-left .music-track-row,
.music-library-left .music-track-btn,
.music-track-popup,
.music-track-more { display: none; }

/* -- 移除旧顶栏 -- */
.music-library-topbar { display: none; }

.hero.flash-highlight,
.section.flash-highlight,
.site-footer.flash-highlight {
  position: relative;
  isolation: isolate;
}

.section-glow-ring {
  position: absolute;
  inset: 10px;
  z-index: 1;
  border: 2px solid var(--primary);
  border-radius: var(--panel-radius);
  box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.22), 0 0 26px rgba(41, 151, 255, 0.32);
  pointer-events: none;
  animation: sectionGlowRing 3s cubic-bezier(0.22, 1, 0.36, 1) 1;
}

@keyframes sectionGlowRing {
  0% {
    opacity: 0;
    transform: scale(0.996);
  }

  10% {
    opacity: 0.55;
    transform: scale(1);
  }

  20% {
    opacity: 0.06;
    transform: scale(1.002);
  }

  30% {
    opacity: 0.55;
    transform: scale(1);
  }

  40% {
    opacity: 0.06;
    transform: scale(1.002);
  }

  50% {
    opacity: 0.55;
    transform: scale(1);
  }

  60% {
    opacity: 0.06;
    transform: scale(1.002);
  }

  100% {
    opacity: 0;
    transform: scale(0.996);
  }
}

.about-panel,
.about-sub-panel {
  margin-bottom: 12px;
