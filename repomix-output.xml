  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.player-bar-center {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 0 0 auto;
}

.player-bar-group {
  display: flex;
  align-items: center;
  gap: 4px;
}

.player-bar-sep {
  width: 1px;
  height: 22px;
  background: rgba(255,255,255,0.12);
  border-radius: 1px;
  flex: none;
}

.player-bar-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: transparent;
  color: rgba(255,255,255,0.6);
  cursor: pointer;
  transition: color 0.2s ease, background 0.2s ease;
}

.player-bar-btn:hover {
  color: #ffffff;
  background: rgba(255,255,255,0.08);
}

.player-bar-btn svg {
  width: 18px;
  height: 18px;
  fill: currentColor;
}

.player-bar-btn .mute-on-icon { display: block; }
.player-bar-btn .mute-off-icon { display: none; }
.player-bar-btn.is-muted .mute-on-icon { display: none; }
.player-bar-btn.is-muted .mute-off-icon { display: block; }

.player-bar-play {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: var(--primary);
  color: #ffffff;
  cursor: pointer;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  box-shadow: 0 2px 12px rgba(41, 151, 255, 0.3);
}

.player-bar-play:hover {
