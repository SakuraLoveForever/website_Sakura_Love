    <script>
(function(){
  var cat = localStorage.getItem("quoteCategory") || "all";
  var sel = document.getElementById("quote-category-select");
  
  function updateQuotes(){
    if (cat === "all") {
      var all = [];
      for (var k in quotesData) { if (quotesData.hasOwnProperty(k)) all = all.concat(quotesData[k]); }
      clickTexts = all;
    } else if (quotesData[cat]) {
      clickTexts = quotesData[cat];
    }
  }
  
  // Populate select
  if (sel) {
    var keys = Object.keys(quotesData);
    for (var i = 0; i < keys.length; i++) {
      var k = keys[i];
      var opt = document.createElement("option");
      opt.value = k;
      opt.textContent = k;
      sel.appendChild(opt);
    }
    sel.value = cat;
    sel.addEventListener("change", function(){
      cat = sel.value;
      localStorage.setItem("quoteCategory", cat);
      updateQuotes();
    });
  }
  
  updateQuotes();
})();
</script>

