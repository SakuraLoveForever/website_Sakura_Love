<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SakuraLoveLauncher</AssemblyName>
    <RootNamespace>SakuraLoveLauncher</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\index.html" Link="index.html" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\404.html" Link="404.html" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\styles.css" Link="styles.css" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\script.js" Link="script.js" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopySiteAssetsAfterPublish" AfterTargets="Publish">
    <ItemGroup>
      <SiteAssetFiles Include="..\assets\**\*" />
      <Live2dAssetFiles Include="..\live2d-widget-v3-main\**\*" />
    </ItemGroup>

    <Copy
      SourceFiles="@(SiteAssetFiles)"
      DestinationFiles="@(SiteAssetFiles->'$(PublishDir)assets\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />

    <Copy
      SourceFiles="@(Live2dAssetFiles)"
      DestinationFiles="@(Live2dAssetFiles->'$(PublishDir)live2d-widget-v3-main\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
